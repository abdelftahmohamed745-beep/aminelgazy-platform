# متغيّرات البيئة — انسخها إلى .env.local عند الحاجة

# Vercel Blob (التخزين الافتراضي على Vercel بعد ربط المتجر)
BLOB_READ_WRITE_TOKEN=
BLOB_STATE_PATH=platform/state.json

# بديل: Upstash Redis / Vercel KV عبر REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
STATE_KEY=aminelgazy:platform:state:v1

# محليًا فقط: مسار ملف الحالة (اختياري)
# STATE_FILE=./data/state.json
